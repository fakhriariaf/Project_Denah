# ============================================
# Property Siteplan ERP — Environment Variables
# ============================================

# Database (Supabase PostgreSQL)
# Local: postgres://postgres:postgres@localhost:5432/postgres
# Production: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Better Auth Configuration
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Minimum 32 characters, different between dev and production!
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-this-to-a-secure-random-secret-minimum-32-chars

# Supabase Storage (for file uploads: attachments, photos, PDFs)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cron Job Secret (protects /api/cron/* endpoints)
# Generate: openssl rand -hex 16
CRON_SECRET=your-cron-secret-token

# Frontend URL (used for Python AI CORS and email links)
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app
FRONTEND_URL=http://localhost:3000

# Python AI Engine URL (Siteplan auto-detection)
# Local: http://127.0.0.1:8000
# Production: https://projectdenah-production.up.railway.app
NEXT_PUBLIC_AI_ENGINE_URL=http://127.0.0.1:8000
